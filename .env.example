# Copy to .env (never commit .env). Prisma reads DATABASE_URL.
# Local development against the Docker MariaDB described in docs/deployment.md:
DATABASE_URL="mysql://root:localdev@127.0.0.1:3307/emirates_report"
# On the server this is the cPanel database, e.g.
# DATABASE_URL="mysql://DBUSER:URL-ENCODED-PASSWORD@localhost:3306/DBNAME"
