# Production settings for the server. Copy to .env in the app folder, fill in the values,
# then:  chmod 600 .env   (only the app's user may read it). NEVER commit .env.
# Everything the app reads is listed in docs/deployment.md.

# --- Database (MariaDB 10.11 / MySQL 8) -------------------------------------------------
# mysql://USER:PASSWORD@HOST:3306/DATABASE   (percent-encode special characters in the password: @ is %40)
DATABASE_URL="mysql://DBUSER:URL-ENCODED-PASSWORD@localhost:3306/DBNAME"

# --- Shopify (from the app's page in the Shopify Dev Dashboard) -------------------------
SHOPIFY_API_KEY="the app's client ID"
SHOPIFY_API_SECRET="the app's client secret (a secret)"
SHOPIFY_APP_URL="https://reporting.emiratesind.com"
SCOPES="read_orders,read_all_orders,read_products,read_locations,read_inventory,read_returns,read_reports"

# --- Report files -------------------------------------------------------------------------
# Working files and (without S3) finished reports. Keep it OUTSIDE the app folder so a
# redeploy never touches it, and make sure the disk has room (about 250 MB per running job).
REPORT_STORAGE_DIR="/home/reportingemirate/app-data/storage"
# Days a finished report is kept before it is deleted ("Expired"). 0 keeps forever.
REPORT_RETENTION_DAYS="30"

# Optional: store finished reports in Amazon S3 instead of on this server's disk.
# REPORT_S3_BUCKET=""
# REPORT_S3_REGION=""
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""

# --- Developer tools ----------------------------------------------------------------------
# The diagnostic page (/app/debug/orders-bulk) is hidden on the server. To use it for a while,
# uncomment this line, run  pm2 restart emirates-reports --update-env , and comment it out again afterwards.
# ENABLE_DEBUG_PAGE="on"
