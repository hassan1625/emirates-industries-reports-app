// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
// MariaDB 10.11 / MySQL 8 (the client's server runs MariaDB). The connection string
// comes from DATABASE_URL, for example mysql://USER:PASSWORD@HOST:3306/DATABASE.
// MySQL gives `String` a 191-character column, so long text is marked @db.Text.
datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?   @db.Text
  expires             DateTime?
  accessToken         String    @db.Text
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?   @db.Text
  refreshTokenExpires DateTime?
}

// Tracks one report generation run through the bulk-operation pipeline.
// `reportType` and `stage` are plain strings, not database enums; allowed values
// are defined in the app code, not the database.
model ReportJob {
  id                String   @id @default(cuid())
  shop              String
  reportType        String
  stage             String   @default("PENDING")
  ordersBulkOpId    String?
  eventsBulkOpId    String?
  productsBulkOpId  String?
  inventoryBulkOpId String?
  resultFileUrl     String?  @db.Text
  resultRows        Int?
  resultBytes       Int?
  // Pipeline bookkeeping (Step 15): last error, downloaded export files on
  // disk, and the request (date range, filters, fields) as JSON text.
  error             String?  @db.Text
  ordersFile        String?  @db.Text
  eventsFile        String?  @db.Text
  productsFile      String?  @db.Text
  inventoryFile     String?  @db.Text
  params            String?  @db.LongText
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([shop, createdAt])
  @@index([stage])
}

// Which Shopify location an order is reported under when it has no POS
// location of its own (Online Store, Mobile App). Data, not code, so a new
// physical location or a different target is an edit here (Dev Plan Step 20).
// Keyed per shop by the order's `sourceName`; the location is stored by id
// (stable) with its name as Shopify spelled it when the row was written.
model LocationMapping {
  id           String   @id @default(cuid())
  shop         String
  sourceName   String
  locationId   String
  locationName String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([shop, sourceName])
}
